@page "/users"
@using Users.Web.App.Components
@using Users.Web.App.Components.Spinner

@inject Domain.Services.IUserService UserService
@inject IDialogService DialogService

@inherits Fluxor.Blazor.Web.Components.FluxorComponent


@* @inject IState<Users.Web.Application.Users.UserState> UserState *@
@* @inherits Fluxor.Blazor.Web.Components.FluxorComponent *@

@if (UserState.Value.IsLoading)
{
    <Spinner />
}
else{
    <MudText Typo="Typo.h3" style="max-width: 1500px;" Class="mb-3">Usuarios</MudText>

    <div class="d-flex justify-content-end mb-3">
        <MudButton OnClick="@CrearUsuario" Color="Color.Primary" Variant="Variant.Filled" Class="px-4 py-2 fw-bold">
            Crear Usuario
        </MudButton>
    </div>

    <div class="mx-auto" style="max-width: 1500px;">
        <MudTable Items="@users" Dense="true" Class="table-responsive">
            <HeaderContent>
                <MudTh>Id</MudTh>
                <MudTh>Nombre</MudTh>
                <MudTh>Email</MudTh>
                <MudTh>Teléfono</MudTh>
                <MudTh>Birth Date</MudTh>
                <MudTh>Acciones</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Id</MudTd>
                <MudTd>@context.Name</MudTd>
                <MudTd>@context.Email</MudTd>
                <MudTd>@context.PhoneNumber</MudTd>
                <MudTd>@context.BirthDate</MudTd>
                <MudTd>
                    <div class="d-flex justify-content-end">
                        <UserActionsButton
                            OnEditarUsuario="@(() => EditarUsuario(@context))"
                            OnEliminarUsuario="@(() => EliminarUsuario(@context))" />
                    </div>
                </MudTd>
            </RowTemplate>
        </MudTable>
    </div>
}
