@using System.Reflection
@using Users.Web.Domain.DTO
@using Users.Web.Domain.Models
@inject IDialogService DialogService

<EditForm Model="@editUser" OnValidSubmit="GuardarAsync">
    <FluentValidationValidator />
    <MudDialog>
        <DialogContent>
            <MudTextField @bind-Value="editUser.Name" Label="Nombre"  />

            <ValidationMessage For="@(() => editUser.Name)" class="danger" />

            <MudTextField @bind-Value="editUser.Email" Label="Email"  />
            <ValidationMessage For="@(() => editUser.Email)" class="danger" />

            <MudTextField @bind-Value="editUser.PhoneNumber" Label="Teléfono"  />
            <ValidationMessage For="@(() => editUser.PhoneNumber)" class="text-danger" />

            @* <MudDatePicker @bind-Date="editUser.BirthDate" Label="Fecha de Nacimiento" /> *@
            @* <ValidationMessage For="@(() => editUser.BirthDate)" class="text-danger" /> *@
            
        </DialogContent>
        <DialogActions>
            <!-- El botón Guardar se activa cuando el formulario es válido -->
            <MudButton ButtonType="ButtonType.Submit" Color="Color.Primary">Guardar</MudButton>
            <MudButton OnClick="Cancelar">Cancelar</MudButton>
        </DialogActions>
    </MudDialog>
</EditForm>

@code {
    [Parameter]
    public UserDTO User { get; set; }

    [Parameter]
    public bool OnEdit { get; set; }

    [CascadingParameter]
    public MudDialogInstance MudDialog { get; set; }

    private UserDTO editUser;

    private DateTime? modalDate;

    protected override void OnInitialized()
    {
        if (OnEdit)
        {
            // Se crea una copia para evitar modificar el original hasta confirmar.
            editUser = User;
        }
        else
        {
            editUser = new UserDTO();
            editUser.BirthDate = new DateTime(1980, 12, 12);
        }
    }

    async Task GuardarAsync()
    {

        // Se asigna la fecha seleccionada al modelo.
        var parameters = new DialogParameters { { "OnEdit", OnEdit } };
        var childDialog = DialogService.Show<UserConfirmModal>("Confirmación", parameters);
        var result = await childDialog.Result;

        if (!result.Canceled)
        {
            // Se cierra el modal retornando el usuario editado o creado.
            MudDialog.Close(DialogResult.Ok(editUser));
        }
    }

    void Cancelar()
    {
        MudDialog.Cancel();
    }
}
