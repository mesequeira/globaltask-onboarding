@using MudBlazor

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.h6">@message</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="Confirmar">Confirmar</MudButton>
        <MudButton Color="Color.Secondary" OnClick="Cancelar">Cancelar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    public string message;
    
    [Parameter]
    public bool OnEdit { get; set; }

    [CascadingParameter]
    MudDialogInstance MudDialog { get; set; }

    protected override void OnInitialized()
    {
        if (OnEdit)
        {
            message = "¿Desea confirmar los cambios realizados?";
        }
        else
        {
            message = "¿Desea crear el usuario?";
        }
    }

    void Confirmar()
    {
        MudDialog.Close(DialogResult.Ok(true));
    }

    void Cancelar()
    {
        MudDialog.Cancel();
    }
}
